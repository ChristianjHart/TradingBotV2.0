# Server
PORT=3000
NODE_ENV=development

# Alpaca API (paper keys recommended — app never places orders)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Account login. The app has ONE owner account (single-tenant). Set SIGNUP_CODE, open the site, create the account, then add your
# API keys under Settings -> Account (they are stored encrypted and OVERRIDE the OPENROUTER_/ALPACA_ vars below, which stay as fallback).
# Without SIGNUP_CODE (or ADMIN_TOKEN) the first account can only be created from localhost (Host must be localhost/127.0.0.1/[::1]).
# REQUIRED on any deployment: with NODE_ENV=production or RENDER set and no account, the API answers 503 setup_required until an account exists.
SIGNUP_CODE=
# Fail closed (503 setup_required) while no account exists even outside production/Render. Implied by NODE_ENV=production and RENDER.
REQUIRE_SETUP=false
# Signs session cookies AND encrypts the stored API keys. Use a long random string (e.g. `openssl rand -hex 32`). If unset, sessions reset on
# every restart and keys cannot be saved. If you lose/change it, stored keys become unreadable (re-enter them).
APP_SECRET=
# Allow more accounts after the owner exists (they still need the code and share ALL data + keys). Default false.
ALLOW_SIGNUP=false
# Optional: Bearer token for scripts/cron (`Authorization: Bearer <ADMIN_TOKEN>`); also gates the API before any account exists and is the
# fallback signup code. Leave empty if you only use the login.
ADMIN_TOKEN=
# CORS is same-origin only; set to allow one external origin. TRUST_PROXY=true behind a proxy (Render) — REQUIRED, or all clients share one rate-limit/login-throttle bucket.
CORS_ORIGIN=
TRUST_PROXY=false

# Scanner
SCAN_INTERVAL_MINUTES=30 # legacy, no longer used: runs follow Settings.schedule (America/New_York)
WATCHLIST_SIZE=12
PREDICTION_HORIZON_HOURS=24

# Optional: fall back to mock market data when Alpaca keys are missing
USE_MOCK_DATA=true

# OpenRouter (AI scanner + trader bots). The AI is REQUIRED: no key = runs end 'blocked' (no_api_key); there is no fallback.
OPENROUTER_API_KEY=
SCANNER_MODEL=deepseek/deepseek-v3.1-terminus
TRADER_MODEL=deepseek/deepseek-chat-v3.1
# Reserved for the later news/earnings bot (stored, unused for now)
NEWS_MODEL=deepseek/deepseek-chat-v3.1
# Hard monthly cap (USD, UTC calendar month) on ALL AI calls. Also editable in Settings. Browse GET /api/models for free/cheaper models.
MONTHLY_AI_BUDGET_USD=20
# Trade proposals expire after this many hours unless approved/rejected (setting proposalTtlHours)
PROPOSAL_TTL_HOURS=6
# DEV/TEST ONLY: deterministic canned LLM so screenshots/tests run with no key. Results are labelled DEMO DATA (source 'demo', model 'mock-llm').
# REFUSED (ignored, loud warning) when NODE_ENV=production or RENDER is set. Leave unset everywhere else.
MOCK_LLM=

# Simulated (paper) account — no real orders are ever placed
PAPER_EQUITY=100000
MAX_OPEN_POSITIONS=10
# Simulated execution + portfolio risk (defaults; editable in Settings)
SLIPPAGE_BPS=5
FEE_BPS=5
MAX_GROSS_PCT=80
MAX_CLASS_PCT=60
MAX_PER_GROUP=3
DAILY_LOSS_HALT_PCT=3

# Supabase (logs, watchlists, positions, accounts, proposals, AI spend) — run supabase/migrations/001..005 in order (or paste supabase/setup_all.sql). Strongly recommended on Render (ephemeral disk).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
