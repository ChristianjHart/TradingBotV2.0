# Server
PORT=3000
NODE_ENV=development

# Alpaca API (paper keys recommended — app never places orders)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Security. SET THIS IN PRODUCTION: /api/run spends OpenRouter credits. When set, mutating/costly endpoints (run, close, settings, worker) need
# `Authorization: Bearer <ADMIN_TOKEN>`. Leave empty to disable auth (local use only).
ADMIN_TOKEN=
# CORS is same-origin only; set to allow one external origin. TRUST_PROXY=true behind a proxy (Render) — required, or all clients share one rate-limit bucket.
CORS_ORIGIN=
TRUST_PROXY=false

# Scanner
SCAN_INTERVAL_MINUTES=30 # only used when Settings.autoRun is enabled
WATCHLIST_SIZE=12
PREDICTION_HORIZON_HOURS=24

# Optional: fall back to mock market data when Alpaca keys are missing
USE_MOCK_DATA=true

# OpenRouter (AI scanner + trader bots)
OPENROUTER_API_KEY=
SCANNER_MODEL=deepseek/deepseek-v3.1-terminus
TRADER_MODEL=deepseek/deepseek-chat-v3.1

# Simulated (paper) account — no real orders are ever placed
PAPER_EQUITY=100000
MAX_OPEN_POSITIONS=10
# Simulated execution + portfolio risk (defaults; editable in Settings)
SLIPPAGE_BPS=5
FEE_BPS=5
MAX_GROSS_PCT=80
MAX_CLASS_PCT=60
MAX_PER_GROUP=3
DAILY_LOSS_HALT_PCT=3

# Supabase (logs, watchlists, positions) — run supabase/migrations/001_init.sql then 002_runs.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
